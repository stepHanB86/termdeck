{
  "name": "termdeck",
  "version": "0.1.0",
  "description": "Fullscreen tiling terminal dashboard for Linux with live Claude Code & Codex status and usage limits",
  "keywords": [
    "terminal",
    "tiling",
    "dashboard",
    "electron",
    "xterm.js",
    "claude-code",
    "codex",
    "ai-agents",
    "linux"
  ],
  "author": "Stephan Böddeker",
  "license": "MIT",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^45.2.2"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "electron@45.2.2": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stepHanB86/termdeck.git"
  },
  "homepage": "https://github.com/stepHanB86/termdeck"
}
